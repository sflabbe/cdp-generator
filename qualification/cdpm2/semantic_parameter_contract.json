    },
    "exact_area_coefficient": 0.225,
    "f_t1": "0.3*f_t",
    "m0": "3*(f_c^2-f_t^2)/(f_c*f_t)*eccentricity/(eccentricity+1)",
    "w_f": "G_Ft/(0.225*f_t)",
    "w_f1": "0.15*w_f"
  },
